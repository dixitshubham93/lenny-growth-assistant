# ─────────────────────────────────────────────────────────────────────────────
# Lenny Growth Assistant – Environment Variables Template
# Copy to .env and fill in real values.  NEVER commit .env to source control.
# All model names and provider choices are configuration-driven.
# No hardcoded model versions in application code.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lenny_db
POSTGRES_USER=lenny
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://lenny:changeme@localhost:5432/lenny_db

# ── LLM provider routing ──────────────────────────────────────────────────────
# Choices: "ollama" | "groq"
# Switch provider here without changing application code.
LLM_PROVIDER=ollama

# ── Ollama (local LLM — mandatory for demo) ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Groq (cloud LLM) ─────────────────────────────────────────────────────────
# Obtain a free API key at https://console.groq.com
# Required when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Choices: "ollama"
# nomic-embed-text must be pulled: ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ── Vector store (Phase 5) ────────────────────────────────────────────────────
# ChromaDB is the current proposed vector store (OQ1 — not yet finalised).
# CHROMA_PERSIST_DIR=./chroma_db

# ── App settings ─────────────────────────────────────────────────────────────
APP_ENV=development            # development | production
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-random-secret
CORS_ORIGINS=http://localhost:3000
